# Resource limits
RUNWAY_COUNT=2
GATE_COUNT=10
GROUND_CREW_COUNT=20

# Separation buffers (seconds)
TAKEOFF_BUFFER_SEC=120
LANDING_BUFFER_SEC=90
MIXED_OPS_BUFFER_SEC=180

# Gates and dependencies
GATE_TURNAROUND_SEC=2700
DEPENDENCY_BUFFER_SEC=600

# Scheduling horizon (seconds)
MAX_HORIZON_SEC=21600

# Runway and operation parameters
DEFAULT_RUNWAY_LENGTH_M=3000
OPERATION_DURATION_SEC=180
